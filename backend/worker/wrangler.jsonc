{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "desk-overflow-checkout",
  "main": "index.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "ENROLLMENT_ENABLED": "0",
    "TAX_APPROVED": "0",
    "IDENTITY_VERIFIED": "0",
    "PROVIDER_READY": "0",
    "AUTOMATION_TESTED": "0",
    "CONTRACT_OFFER_APPROVED": "0",
    "SELLING_STATES": ""
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "desk-overflow-enrollment",
    "database_id": "REPLACE_WITH_CREATED_D1_DATABASE_ID",
    "migrations_dir": "."
  }]
}
